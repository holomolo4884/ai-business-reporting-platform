# =====================================
# Django
# =====================================
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# =====================================
# PostgreSQL
# =====================================
# Для локальной разработки: localhost
# Для Docker: db
POSTGRES_DB=reporting
POSTGRES_USER=reporting
POSTGRES_PASSWORD=reporting
POSTGRES_HOST=db
POSTGRES_PORT=5432

# =====================================
# Redis
# =====================================
# Для локальной разработки: localhost
# Для Docker: redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# =====================================
# JWT
# =====================================
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# =====================================
# AI Provider
# =====================================
# AI Provider: fake (для разработки без API ключа), gigachat (Сбер), openai
AI_PROVIDER=gigachat

# Авторизационный ключ для GigaChat API
# Получить можно на https://developers.sber.ru/studio/workspaces
# Пример: MzdlZDJhNGYtYTQyYi00NjE4LTkxZDQtZmIzYzNl...
AI_API_KEY=

# Модель GigaChat:
# - GigaChat (базовая, быстрее)
# - GigaChat-Pro (улучшенная)
# - GigaChat-Max (максимальная)
# - GigaChat-2 (новая версия, рекомендуемая)
AI_MODEL=GigaChat

# Область применения GigaChat:
# - GIGACHAT_API_PERS (личное использование, по умолчанию)
# - GIGACHAT_API_B2B (бизнес)
# - GIGACHAT_API_CORP (корпоративный)
AI_SCOPE=GIGACHAT_API_PERS

# Таймаут запроса к AI в секундах
# GigaChat может отвечать медленнее, поэтому ставим 60
AI_TIMEOUT_SECONDS=60

# Максимальное количество попыток при ошибке
AI_MAX_RETRIES=3

# Проверка SSL сертификатов для GigaChat
# False для локальной разработки, True для продакшена
AI_VERIFY_SSL=False

# Температура генерации (0.0 - 1.0)
# 0 = детерминированный ответ, 1 = более креативный
AI_TEMPERATURE=0.7

# Максимум токенов в ответе
AI_MAX_TOKENS=2000

# =====================================
# Notification Service
# =====================================
NOTIFICATION_SERVICE_URL=http://notification-service:8001
NOTIFICATION_INTERNAL_API_KEY=change-me

# =====================================
# Flower
# =====================================
FLOWER_PORT=5555

# =====================================
# CORS
# =====================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
