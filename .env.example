# =====================================
# Django
# =====================================
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# =====================================
# PostgreSQL
# =====================================
POSTGRES_DB=reporting
POSTGRES_USER=reporting
POSTGRES_PASSWORD=reporting
POSTGRES_HOST=db
POSTGRES_PORT=5432

# =====================================
# Redis
# =====================================
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# =====================================
# JWT
# =====================================
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# =====================================
# AI Provider
# =====================================
# Варианты: fake, openai, anthropic, local
AI_PROVIDER=fake

# Реальный AI API, сюда позже добавишь ключ
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=3

# =====================================
# Notification Service
# =====================================
NOTIFICATION_SERVICE_URL=http://notification-service:8001
NOTIFICATION_INTERNAL_API_KEY=change-me

# =====================================
# Flower
# =====================================
FLOWER_PORT=5555
