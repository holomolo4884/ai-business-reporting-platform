# ============================================
# Django
# ============================================
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-production-use-strong-random-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================
# PostgreSQL
# ============================================
# Локально: localhost:5433 (порт 5433 чтобы не конфликтовать с системным PostgreSQL)
# В Docker: переопределяется на db:5432 автоматически
POSTGRES_DB=reporting
POSTGRES_USER=reporting
POSTGRES_PASSWORD=reporting
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# ============================================
# Redis / Celery
# ============================================
# Локально: localhost:6379
# В Docker: переопределяется на redis:6379 автоматически
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ============================================
# JWT
# ============================================
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ============================================
# AI Provider
# ============================================
# Варианты: fake (без API ключа), gigachat (Сбер), openai
AI_PROVIDER=gigachat

# Получить ключ: https://developers.sber.ru/studio/workspaces
# Пример: MzdlZDJhNGYtYTQyYi00NjE4LTkxZDQtZmIzYzNl...
AI_API_KEY=your-gigachat-auth-token-here

# Модели: GigaChat, GigaChat-Pro, GigaChat-Max, GigaChat-2
AI_MODEL=GigaChat-2

# Область: GIGACHAT_API_PERS (личное), GIGACHAT_API_B2B (бизнес), GIGACHAT_API_CORP (корп)
AI_SCOPE=GIGACHAT_API_PERS

AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=3
AI_VERIFY_SSL=False
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2000

# ============================================
# Notification Service
# ============================================
# Локально: http://localhost:8001
# В Docker: переопределяется на http://notification-service:8001 автоматически
NOTIFICATION_SERVICE_URL=http://localhost:8001
NOTIFICATION_INTERNAL_API_KEY=change-me-internal-api-key

# SMTP для email уведомлений
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_USE_TLS=True

# Telegram (опционально)
TELEGRAM_BOT_TOKEN=

# ============================================
# Flower (Celery monitoring)
# ============================================
FLOWER_PORT=5555

# ============================================
# CORS
# ============================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
